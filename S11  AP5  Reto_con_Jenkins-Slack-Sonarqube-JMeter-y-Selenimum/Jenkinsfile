pipeline {
    agent any
    
    environment {
        SONAR_TOKEN = credentials('sonar-token')
        SLACK_WEBHOOK = credentials('slack-webhook')
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código fuente...'
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                echo 'Compilando proyecto...'
                bat 'mvn clean install -DskipTests'
            }
        }
        
        stage('Test') {
            steps {
                echo 'Ejecutando pruebas unitarias...'
                bat 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                echo 'Analizando código con SonarQube...'
                bat """
                    mvn sonar:sonar ^
                    -Dsonar.projectKey=proyecto-base-ci ^
                    -Dsonar.host.url=http://localhost:9000 ^
                    -Dsonar.login=%SONAR_TOKEN%
                """
            }
        }
        
        stage('Start Application') {
            steps {
                echo 'Iniciando aplicación Spring Boot...'
                bat 'start /B mvn spring-boot:run'
                sleep 30
            }
        }
        
        stage('JMeter Load Test') {
            steps {
                echo 'Ejecutando pruebas de carga con JMeter...'
                bat """
                    jmeter -n -t jmeter/LoadTest.jmx ^
                    -l jmeter/results/results.jtl ^
                    -e -o jmeter/results/html
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'jmeter/results/**/*', allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline ejecutado exitosamente'
            script {
                def message = """
                {
                    "text": "✅ *Pipeline Exitoso*",
                    "blocks": [
                        {
                            "type": "section",
                            "text": {
                                "type": "mrkdwn",
                                "text": "*Proyecto:* ${env.JOB_NAME}\\n*Build:* #${env.BUILD_NUMBER}\\n*Estado:* SUCCESS ✅"
                            }
                        }
                    ]
                }
                """
                bat "curl -X POST -H \"Content-type: application/json\" --data \"${message}\" %SLACK_WEBHOOK%"
            }
        }
        
        failure {
            echo 'Pipeline falló'
            script {
                def message = """
                {
                    "text": "❌ *Pipeline Fallido*",
                    "blocks": [
                        {
                            "type": "section",
                            "text": {
                                "type": "mrkdwn",
                                "text": "*Proyecto:* ${env.JOB_NAME}\\n*Build:* #${env.BUILD_NUMBER}\\n*Estado:* FAILURE ❌"
                            }
                        }
                    ]
                }
                """
                bat "curl -X POST -H \"Content-type: application/json\" --data \"${message}\" %SLACK_WEBHOOK%"
            }
        }
        
        always {
            echo 'Limpiando recursos...'
            bat 'taskkill /F /IM java.exe /T || exit 0'
        }
    }
}
